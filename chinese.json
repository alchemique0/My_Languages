  "grammar": {
    "sentence_structure": {
      "basic_order": "SVO (Subject-Verb-Object)",
      "example_subject": "我",
      "example_verb": "吃",
      "example_object": "米饭",
      "full_sentence": "我吃米饭。(I eat rice.)"
    },
    "particles": {
      "ma": {
        "character": "吗",
        "function": "Questions - adds question form at end of sentence",
        "example": "你好吗？(How are you?)"
      },
      "de": {
        "character": "的",
        "function": "Possession - 'of' or possessive marker",
        "example": "我的书 (my book)"
      },
      "le": {
        "character": "了",
        "function": "Aspect - indicates completed action",
        "example": "我吃了米饭。(I ate rice.)"
      },
      "ba": {
        "character": "吧",
        "function": "Suggestion or rhetorical question",
        "example": "我们去吧。(Let's go.)"
      }
    },
    "subject_pronouns": {
      "first_person_singular": "我 (wǒ) - I",
      "second_person_singular": "你 (nǐ) - you",
      "third_person_singular": "他/她/它 (tā) - he/she/it",
      "first_person_plural": "我们 (wǒmen) - we",
      "second_person_plural": "你们 (nǐmen) - you all",
      "third_person_plural": "他们/她们/它们 (tāmen) - they"
    },
    "verb_forms": {
      "note": "Chinese verbs don't conjugate by person or tense",
      "tense_marking": "Tense is marked by time words or particles",
      "present": "吃 (chī) - eat/eats",
      "past_with_particle": "吃了 (chīle) - ate",
      "future": "会吃 (huì chī) - will eat",
      "continuous": "在吃 (zài chī) - is eating"
    },
    "measure_words": {
      "description": "Classifiers used between numbers and nouns",
      "examples": [
        {
          "classifier": "个",
          "pinyin": "gè",
          "for": "general/people items",
          "example": "一个人 (one person)"
        },
        {
          "classifier": "本",
          "pinyin": "běn",
          "for": "books",
          "example": "一本书 (one book)"
        },
        {
          "classifier": "只",
          "pinyin": "zhī",
          "for": "animals",
          "example": "一只猫 (one cat)"
        }
      ]
    },
    "adjectives": {
      "description": "Adjectives function like verbs and can stand alone as predicates",
      "example_positive": "这个苹果很好。(This apple is good.)",
      "example_negative": "这个梨很酸。(This pear is sour.)"
    },
    "word_order_for_questions": {
      "yes_no_questions": "Add 吗 (ma) at the end",
      "example": "你去了吗？(Did you go?)",
      "question_words": "Place at beginning of sentence",
      "question_words_list": {
        "谁": "shéi - who",
        "什么": "shénme - what",
        "哪里": "nǎlǐ - where",
        "什么时候": "shénme shíhou - when",
        "为什么": "wèishéme - why",
        "怎么": "zěnme - how"
      }
    }
